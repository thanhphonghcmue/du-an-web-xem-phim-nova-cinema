# Nova Cinema Backend Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database: PostgreSQL (Local or Supabase)
DATABASE_URL=
TEST_DATABASE_URL=
SEED_DEMO_PASSWORD=
SEED_BASE_DATE=

# Redis: Upstash Cloud (REDIS_URL) or Local Redis (HOST/PORT)
# Upstash: rediss://default:xxxx@xxxx.upstash.io:6379
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=6381
TEST_REDIS_PASSWORD=
TEST_REDIS_DB=0
BULLMQ_PREFIX=nova:development
HEALTH_TIMEOUT_MS=2500
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=60

# Required: Independent JWT secrets (min 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Required: Sandbox Payment secret (min 32 chars, independent from JWT)
PAYMENT_SANDBOX_SECRET=
PAYMENT_SANDBOX_BASE_URL=http://localhost:4000
PAYMENT_RETURN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local or Production SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_TIMEOUT_MS=10000
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tickets@nova.local
CHECK_IN_BEFORE_MINUTES=60
CHECK_IN_AFTER_MINUTES=30

NOVA_TEST_CONTROLS=false
NOVA_COMBO_STORE_PATH=
