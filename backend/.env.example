# Phase9 runtime: database, Redis, independent JWT/Sandbox secrets and SMTP settings.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:4000

# Phase 1: supply your own local PostgreSQL connection string; never commit .env.
DATABASE_URL=
TEST_DATABASE_URL=
SEED_DEMO_PASSWORD=
SEED_BASE_DATE=
FRONTEND_URL=http://localhost:3000
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=6381
TEST_REDIS_PASSWORD=
TEST_REDIS_DB=0
BULLMQ_PREFIX=nova:development
HEALTH_TIMEOUT_MS=2500
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=60

# Required: npm run auth:configure generates independent private secrets.
# Access expiry <= 1h; refresh expiry <= 90d and longer than access.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Required: npm run payment:configure creates a private local HMAC key.
# Independent from both JWT keys, at least32 characters. Sandbox never charges money.
PAYMENT_SANDBOX_SECRET=
# Public backend origin (no trailing slash/path); HTTPS except loopback development.
PAYMENT_SANDBOX_BASE_URL=http://localhost:4000
# Exact allowed frontend origins; returnUrl must not contain credentials or a fragment.
PAYMENT_RETURN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase9 local mailbox: npm run mail:up (SMTP1025, inbox8025, loopback only).
# For external SMTP set private credentials; use secure465 or required STARTTLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_TIMEOUT_MS=10000
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tickets@nova.local
CHECK_IN_BEFORE_MINUTES=60
CHECK_IN_AFTER_MINUTES=30
