# HTTP bootstrap reads PORT, HOST and CORS_ORIGINS. Prisma/seed use the database variables below.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:4000

# Phase 1: supply your own local PostgreSQL connection string; never commit .env.
DATABASE_URL=
TEST_DATABASE_URL=
SEED_DEMO_PASSWORD=
SEED_BASE_DATE=
FRONTEND_URL=http://localhost:3000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Phase 3: generate independent random secrets locally, e.g. openssl rand -hex 32.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Phase 8: independent secret for HMAC-SHA512 sandbox signatures.
PAYMENT_SANDBOX_SECRET=

# Phase 9: SMTP transport and check-in window (minutes before/after showtime).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CHECK_IN_BEFORE_MINUTES=60
CHECK_IN_AFTER_MINUTES=30
