      "id": "contact",
      "path": "/lien-he",
      "role": "PUBLIC"
    },
    {
      "id": "account",
      "path": "/tai-khoan",
      "role": "GUEST_OR_OWNER",
      "states": [
        "sign-in",
        "sign-up",
        "member-profile",
        "pending-bookings",
        "ticket-wallet"
      ]
    },
    {
      "id": "sign-in",
      "path": "/dang-nhap",
      "role": "GUEST_OR_OWNER",
      "note": "Existing dedicated authentication route; capture sign-in and sign-up tabs."
    },
    {
      "id": "admin",
      "path": "/quan-tri",
      "role": "ADMIN",
      "states": [
        "dashboard",
        "catalogue",
        "room-builder",
        "reconciliation",
        "audit"
      ]
    },
    {
      "id": "staff",
      "path": "/soat-ve",
      "role": "STAFF_OR_ADMIN"
    },
    {
      "id": "preview",
      "path": "/xem-truoc",
      "role": "PUBLIC",
      "note": "Labelled read-only preview. Cannot hold seats, pay or issue tickets."
    }
  ],
  "states": [
    {
      "id": "cinema-picker",
      "page": "booking",
      "entry": "Open Chọn cụm rạp; capture region, search and selected cinema."
    },
    {
      "id": "calendar",
      "page": "booking",
      "entry": "Select an actual movie and cinema, then open Chọn ngày chiếu."
    },
    {
      "id": "seat-select",
      "page": "booking",
      "entry": "Sign in and select a real future showtime; open the seat dialog."
    },
    {
      "id": "seat-holding",
      "page": "booking",
      "entry": "Hold an available test seat. Use the server expiry; do not reset the countdown."
    },
    {
      "id": "payment-methods",
      "page": "booking",
      "entry": "Capture the four gateway controls inside the real held-order card."
    },
    {
      "id": "sandbox",
      "page": "booking",
      "entry": "Follow the server-created signed Sandbox URL. Do not invent or commit the signed query."
    },
    {
      "id": "paid-qr",
      "page": "booking",
      "entry": "Complete Sandbox on an owned disposable test order and wait for the server-issued ticket."
    },
    {
      "id": "expired",
      "page": "booking",
      "entry": "Use the expiry test fixture or an actually expired hold."
    },
    {
      "id": "cancelled",
      "page": "booking",
      "entry": "Cancel an owned test hold; confirm the seat is available again."
    },
    {
      "id": "food-detail",
      "page": "food",
      "entry": "Open Xem chi tiết on a current combo."
    },
    {
      "id": "food-cart",
      "page": "food",
      "entry": "Add current menu items; capture the basket and transfer-to-booking action."
    },
    {
      "id": "form-errors",
      "page": "account",
      "entry": "Capture actual 400 field validation and a duplicate-email 409."
    },
    {
      "id": "staff-valid",
      "page": "staff",
      "entry": "Verify an unused owned test ticket without consuming it."
    },
    {
      "id": "staff-used",
      "page": "staff",
      "entry": "Confirm check-in, then verify the same test ticket again."
    },
    {
      "id": "staff-mismatch",
      "page": "staff",
      "entry": "Verify an unused test ticket with a different real showtime selected."
    },
    {
      "id": "staff-unknown",
      "page": "staff",
      "entry": "Enter a well-formed nonexistent test ticket hash."
    }
  ],
