# Frontend moved to frontend/: prefer copying frontend/.env.example to frontend/.env.local.
# Existing root .env* upstream/origin values remain supported as fallback.
# Server-only upstream. Browser requests go to the same-origin /api/v1 BFF.
BACKEND_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
