generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  CUSTOMER
  STAFF
  ADMIN
}

enum CMemberTier {
  SILVER
  GOLD
  DIAMOND
}

enum AccountStatus {
  ACTIVE
  LOCKED
  INACTIVE
}

enum AgeRating {
  P
  K
  T13
  T16
  T18
}

enum MovieStatus {
  NOW_SHOWING
  COMING_SOON
  ENDED
}

enum RoomType {
  STANDARD_2D
  IMAX_70MM_LASER
  DOLBY_ATMOS
}

enum SeatType {
  STANDARD
  VIP
  SWEETBOX
}

enum BookingStatus {
  PENDING
  HOLDING
  PAID
  CANCELLED
  EXPIRED
}

enum BookingSeatStatus {
  AVAILABLE
  HOLDING
  SOLD
}

enum PaymentProvider {
  SANDBOX
  MOMO
  ZALOPAY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model User {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String         @unique @db.VarChar(254)
  passwordHash     String         @map("password_hash") @db.VarChar(255)
  fullName         String         @map("full_name") @db.VarChar(120)
  phone            String?        @db.VarChar(20)
  role             UserRole       @default(CUSTOMER)
  status           AccountStatus  @default(ACTIVE)
  cMemberPoints    Int            @default(0) @map("c_member_points")
  cMemberTier      CMemberTier    @default(SILVER) @map("c_member_tier")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings         Booking[]
  refreshTokens    RefreshToken[]
  checkedInTickets ETicket[]      @relation("StaffCheckIn")

  @@index([role])
  @@map("users")
}

model Movie {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String      @db.VarChar(200)
  description     String      @db.Text
  durationMinutes Int         @map("duration_minutes")
  releaseDate     DateTime    @map("release_date") @db.Timestamptz(3)
  trailerUrl      String?     @map("trailer_url") @db.Text
  posterUrl       String?     @map("poster_url") @db.Text
  ageRating       AgeRating   @map("age_rating")
  status          MovieStatus @default(COMING_SOON)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  showtimes       Showtime[]

  @@index([status])
  @@index([releaseDate])
  @@map("movies")
}

model Cinema {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(120)
  address   String   @db.VarChar(300)
  city      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  rooms     Room[]

  @@index([city])
  @@map("cinemas")
}

model Room {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cinemaId   String     @map("cinema_id") @db.Uuid
  name       String     @db.VarChar(120)
  roomType   RoomType   @map("room_type")
  totalSeats Int        @default(0) @map("total_seats")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  cinema     Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seats      Seat[]
  showtimes  Showtime[]

  @@unique([cinemaId, name])
  @@index([cinemaId])
  @@map("rooms")
}

model Seat {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId        String        @map("room_id") @db.Uuid
  seatRow       String        @map("seat_row") @db.VarChar(8)
  seatColumn    Int           @map("seat_column")
  seatType      SeatType      @map("seat_type")
  priceModifier Decimal       @map("price_modifier") @db.Decimal(4, 2)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookingSeats  BookingSeat[]

  @@unique([roomId, seatRow, seatColumn])
  @@unique([id, roomId])
  @@index([roomId])
  @@index([roomId, seatType])
  @@map("seats")
}

model Showtime {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movieId         String        @map("movie_id") @db.Uuid
  roomId          String        @map("room_id") @db.Uuid
  startTime       DateTime      @map("start_time") @db.Timestamptz(3)
  endTime         DateTime      @map("end_time") @db.Timestamptz(3)
  baseTicketPrice Decimal       @map("base_ticket_price") @db.Decimal(14, 2)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  movie           Movie         @relation(fields: [movieId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookings        Booking[]
  bookingSeats    BookingSeat[]

  @@unique([id, roomId])
  @@index([movieId])
  @@index([roomId])
  @@index([startTime])
  @@index([roomId, startTime])
  @@index([movieId, startTime])
  @@map("showtimes")
}

model Combo {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String         @db.VarChar(120)
  description   String         @db.Text
  price         Decimal        @db.Decimal(14, 2)
  imageUrl      String?        @map("image_url") @db.Text
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookingCombos BookingCombo[]

  @@index([isActive])
  @@map("combos")
}

model Booking {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode         String         @unique @map("order_code") @db.VarChar(40)
  userId            String         @map("user_id") @db.Uuid
  showtimeId        String         @map("showtime_id") @db.Uuid
  totalTicketAmount Decimal        @default(0) @map("total_ticket_amount") @db.Decimal(14, 2)
  totalComboAmount  Decimal        @default(0) @map("total_combo_amount") @db.Decimal(14, 2)
  discountAmount    Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  finalAmount       Decimal        @default(0) @map("final_amount") @db.Decimal(14, 2)
  status            BookingStatus  @default(PENDING)
  baseTicketPrice   Decimal?       @map("base_ticket_price") @db.Decimal(14, 2)
  membershipTier    CMemberTier?   @map("membership_tier")
  discountRate      Decimal?       @map("discount_rate") @db.Decimal(4, 3)
  idempotencyKey    String?        @map("idempotency_key") @db.Uuid
  requestHash       String?        @map("request_hash") @db.VarChar(64)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiredAt         DateTime       @map("expired_at") @db.Timestamptz(3)
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  showtime          Showtime       @relation(fields: [showtimeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seats             BookingSeat[]
  combos            BookingCombo[]
  payments          Payment[]
  ticket            ETicket?

  @@unique([id, showtimeId])
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([showtimeId])
  @@index([status, expiredAt])
  @@index([status, createdAt, showtimeId])
  @@map("bookings")
}

model BookingSeat {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String            @map("booking_id") @db.Uuid
  seatId     String            @map("seat_id") @db.Uuid
  showtimeId String            @map("showtime_id") @db.Uuid
  roomId     String            @map("room_id") @db.Uuid
  price      Decimal           @db.Decimal(14, 2)
  status     BookingSeatStatus @default(HOLDING)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking    Booking           @relation(fields: [bookingId, showtimeId], references: [id, showtimeId], onDelete: Restrict, onUpdate: Restrict)
  seat       Seat              @relation(fields: [seatId, roomId], references: [id, roomId], onDelete: Restrict, onUpdate: Restrict)
  showtime   Showtime          @relation(fields: [showtimeId, roomId], references: [id, roomId], onDelete: Restrict, onUpdate: Restrict)

  @@index([bookingId])
  @@index([showtimeId])
  @@index([seatId])
  @@index([showtimeId, seatId])
  @@index([showtimeId, seatId, status])
  @@map("booking_seats")
}

model BookingCombo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  comboId   String   @map("combo_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([bookingId, comboId])
  @@index([comboId])
  @@map("booking_combos")
}

model ETicket {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String    @unique @map("booking_id") @db.Uuid
  ticketHash         String    @unique @map("ticket_hash") @db.VarChar(64)
  qrCodeBase64       String    @map("qr_code_base64") @db.Text
  isCheckedIn        Boolean   @default(false) @map("is_checked_in")
  checkedInAt        DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkedInByStaffId String?   @map("checked_in_by_staff_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkedInByStaff   User?     @relation("StaffCheckIn", fields: [checkedInByStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([checkedInByStaffId])
  @@map("e_tickets")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Payment {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String          @map("booking_id") @db.Uuid
  provider        PaymentProvider @default(SANDBOX)
  transactionCode String          @unique @map("transaction_code") @db.VarChar(96)
  amount          Decimal         @db.Decimal(14, 2)
  status          PaymentStatus   @default(PENDING)
  requestPayload  Json?           @map("request_payload")
  responsePayload Json?           @map("response_payload")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([bookingId])
  @@map("payments")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(64)
  aggregateType String    @map("aggregate_type") @db.VarChar(32)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy      String?   @map("locked_by") @db.VarChar(100)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// Deliberately no FK: history survives deleting a catalogue item or test account.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(16)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String   @map("entity_id") @db.Uuid
  summary    String   @db.VarChar(300)
  changes    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
