{
  "name": "nova-cinema-infinity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "dev": "node scripts/dev-fullstack.cjs",
    "build": "npm run build:backend && npm run build:frontend",
    "lint": "npm run lint --workspace frontend && eslint scripts",
    "test": "playwright test",
    "preview": "npm run start --workspace frontend",
    "format": "prettier --write frontend/src tests docs scripts *.js *.mjs README.md",
    "start": "npm run start --workspace frontend",
    "setup:local": "node scripts/setup-local.cjs",
    "dev:full": "node scripts/dev-fullstack.cjs",
    "test:unit": "node --test scripts/*.test.mjs scripts/memory-contract.test.cjs scripts/development-seed.test.cjs backend/scripts/advance-programme.test.cjs frontend/src/app/api/v1/catalog-compression.test.mjs",
    "test:backend": "npm run check --workspace backend",
    "test:db": "npm run test:db --workspace backend",
    "seed": "node scripts/seed-native.cjs",
    "prebuild:backend": "npm run prisma:generate --workspace backend",
    "pretest:backend": "npm run prisma:generate --workspace backend",
    "pretest:db": "npm run prisma:generate --workspace backend",
    "pretest": "npm run build:backend",
    "pretest:business": "npm run prisma:generate --workspace backend",
    "test:business": "npm run test:e2e --workspace backend -- --runTestsByPath test/booking-concurrency.e2e-spec.ts test/showtime-conflict.e2e-spec.ts test/payments.e2e-spec.ts test/tickets.e2e-spec.ts",
    "qa:native": "node scripts/qa-native.cjs",
    "qa:lab04": "node scripts/qa-native.cjs --lab04"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@react-three/fiber": "^9.8.1",
    "date-fns": "^4.4.0",
    "framer-motion": "latest",
    "gsap": "3.15.0",
    "lucide-react": "latest",
    "next": "^16.4.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "4.2.0",
    "react": "latest",
    "react-day-picker": "^9.14.0",
    "react-dom": "latest",
    "socket.io-client": "4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
