# ==============================================================================
# NOVA CINEMA - PRODUCTION ENVIRONMENT CONFIGURATION (NO-DOCKER)
# Cloud Stack: Next.js (Vercel) + NestJS (Render) + PostgreSQL (Supabase) + Redis (Upstash)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BIẾN MÔI TRƯỜNG DÀNH CHO BACKEND (CẤU HÌNH TRÊN RENDER -> ENVIRONMENT)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# [BẮT BUỘC] URL domain frontend trên Vercel (không có dấu gạch chéo cuối /)
# Ví dụ: https://nova-cinema.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app

# [BẮT BUỘC] SUPABASE POSTGRESQL CONNECTION STRING
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Khuyên dùng Session Pooler (port 5432) hoặc Transaction Pooler (port 6543 có kèm ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# (Tùy chọn nếu dùng Direct Connection cho Migration trên port 5432):
# DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# [BẮT BUỘC] UPSTASH REDIS CONNECTION STRING
# Lấy tại Upstash Console -> Chọn database -> Details -> REST / Node.js -> Connection String (rediss://...)
REDIS_URL=rediss://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-ENDPOINT].upstash.io:6379
BULLMQ_PREFIX=nova:production

# [BẮT BUỘC] CÁC MÃ BẢO MẬT ĐỘC LẬP (TỐI THIỂU 32 KÝ TỰ, MỖI KHÓA PHẢI KHÁC NHAU HOÀN TOÀN)
# Mẹo tạo nhanh trong terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_32_character_secret_key_access_001
JWT_REFRESH_SECRET=replace_with_a_random_32_character_secret_key_refresh_002
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# [BẮT BUỘC] KHÓA BẢO MẬT THANH TOÁN SANDBOX VNPAY / MOCK (KHÁC JWT VÀ >= 32 KÝ TỰ)
PAYMENT_SANDBOX_SECRET=replace_with_a_random_32_character_secret_payment_003
PAYMENT_SANDBOX_BASE_URL=https://your-backend.onrender.com
PAYMENT_RETURN_ORIGINS=https://your-frontend.vercel.app

# Tùy chọn: SMTP gửi vé qua Email (nếu chưa có thì hệ thống dùng chế độ mock)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=tickets@novacinema.com

# Giới hạn tốc độ & kiểm tra sức khỏe
HEALTH_TIMEOUT_MS=5000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
NOVA_TEST_CONTROLS=false

# ------------------------------------------------------------------------------
# 2. BIẾN MÔI TRƯỜNG DÀNH CHO FRONTEND (CẤU HÌNH TRÊN VERCEL -> ENVIRONMENT VARIABLES)
# ------------------------------------------------------------------------------
# URL của Backend trên Render (BFF Next.js route handlers sẽ chuyển tiếp API sang đây)
BACKEND_API_URL=https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1

# URL chính của Frontend trên Vercel
NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app
