{
  "name": "nova-cinema-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA Cinema NestJS backend — phased implementation",
  "type": "commonjs",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test prisma scripts --max-warnings 0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run build",
    "format": "prettier --write src test prisma scripts docs *.json *.cjs *.yml README.md",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "db:configure": "node scripts/configure-database.cjs",
    "db:up": "docker compose --env-file .runtime/database.env -f compose.database.yml up -d --wait",
    "db:up:test": "docker compose --env-file .runtime/database.env -f compose.database.yml --profile test up -d --wait",
    "db:down": "docker compose --env-file .runtime/database.env -f compose.database.yml --profile test down",
    "db:migrate:test": "node scripts/migrate-test-database.cjs",
    "test:db": "jest --config test/jest-database.config.cjs --runInBand",
    "infra:configure": "node scripts/configure-infrastructure.cjs",
    "infra:up": "docker compose --env-file .runtime/database.env --env-file .runtime/infrastructure.env -f compose.database.yml -f compose.infrastructure.yml up -d --wait",
    "infra:up:test": "docker compose --env-file .runtime/database.env --env-file .runtime/infrastructure.env -f compose.database.yml -f compose.infrastructure.yml --profile test up -d --wait",
    "infra:down": "docker compose --env-file .runtime/database.env --env-file .runtime/infrastructure.env -f compose.database.yml -f compose.infrastructure.yml --profile test down",
    "payment:configure": "node scripts/configure-payment.cjs",
    "mail:up": "docker compose -p nova-cinema-mail -f compose.mail.yml up -d --wait",
    "mail:down": "docker compose -p nova-cinema-mail -f compose.mail.yml down",
    "auth:configure": "node scripts/configure-auth.cjs",
    "db:seed:discovery": "node scripts/seed-discovery.cjs",
    "db:seed:programme": "node scripts/seed-programme.cjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.2.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/platform-socket.io": "^11.2.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.2.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "nodemailer": "^7.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "^3.0.0",
    "prisma": "6.19.0",
    "socket.io-client": "4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
