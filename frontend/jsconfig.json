{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/services/*": ["./src/services/*", "./src/api/*"],
      "@/app/*": ["./src/app/*"],
      "@/api/*": ["./src/api/*"],
      "@/styles/*": ["./src/*"],
      "@/types/*": ["./src/*"],
      "@/lib/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
