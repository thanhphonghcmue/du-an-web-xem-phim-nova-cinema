# Biến môi trường Frontend (Local Development & Vercel Production)
# Next.js BFF proxy sẽ chuyển tiếp yêu cầu API sang Backend.
BACKEND_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trên Vercel:
# BACKEND_API_URL=https://your-backend.onrender.com/api/v1
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
